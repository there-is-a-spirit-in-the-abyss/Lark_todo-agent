{
    admin off
    persist_config off
    auto_https disable_redirects
    default_sni {$TEAM_HOST}
}

{$TEAM_HOST} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    request_body {
        max_size 128KB
    }
    @team path /team/* /api/team/*
    handle @team {
        reverse_proxy {$TEAM_UPSTREAM:127.0.0.1:8001}
    }
    handle {
        respond "Not found" 404
    }
}
