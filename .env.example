# Prepare the private .env with: .venv/bin/python -m huiyang.manage prepare-env
APP_ENV=production
# Default bot language: zh-CN or en-US; chat /language commands can override.
APP_LANGUAGE=zh-CN
PLATFORM_ENABLED=true
FEISHU_EVENT_MODE=long_connection
APP_TIMEZONE=UTC
FEISHU_APP_ID=
FEISHU_APP_SECRET=
LLM_PROVIDER=openai_compatible
# Provider's HTTPS API root, including /v1 when required by that provider.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# First target-group message binds its API-reported owner in PostgreSQL.
# No owner message, nickname match, binding code, or manual admin ID required.
# Program generates this; not a platform credential to obtain manually.
POSTGRES_PASSWORD=
OVERDUE_REMINDER_POLICY=disabled
